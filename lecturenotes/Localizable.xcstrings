    "LectraAI turns long material into a transcript plus concise summaries, so the main ideas are easy to review." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحوّل LectraAI المحتوى الطويل إلى نص مفرغ وملخصات موجزة، لتصبح الأفكار الأساسية أسهل في المراجعة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI converteix el material llarg en una transcripció i resums concisos, de manera que les idees principals són fàcils de revisar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI přemění dlouhý materiál na přepis a stručné shrnutí, takže hlavní myšlenky lze snadno zopakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI forvandler langt materiale til en transskription plus kortfattede resuméer, så hovedideerne er nemme at gennemgå."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI wandelt langes Material in ein Transkript mit prägnanten Zusammenfassungen um, sodass die Hauptideen leicht überprüft werden können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το LectraAI μετατρέπει το εκτενές υλικό σε μεταγραφή συν συνοπτικές περιλήψεις, επομένως οι κύριες ιδέες είναι εύκολο να αναθεωρηθούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI convierte material extenso en una transcripción y resúmenes concisos, para que las ideas principales sean fáciles de revisar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI muuttaa pitkästä materiaalista tekstin ja tiiviit yhteenvedot, joten tärkeimmät ideat on helppo tarkastella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI transforme les longs documents en une transcription ainsi que des résumés concis, de sorte que les idées principales soient faciles à réviser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI הופך חומר ארוך לתמלול בתוספת סיכומים תמציתיים, כך שקל לעיין ברעיונות העיקריים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI लंबी सामग्री को एक प्रतिलेख और संक्षिप्त सारांश में बदल देता है, इसलिए मुख्य विचारों की समीक्षा करना आसान होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI dugi materijal pretvara u prijepis plus sažete sažetke, tako da je glavne ideje lako pregledati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az LectraAI a hosszú anyagokat átiratmá és tömör összefoglalóvá alakítja, így a főbb ötletek könnyen áttekinthetők."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI mengubah materi panjang menjadi transkrip ditambah ringkasan singkat, sehingga gagasan utama mudah untuk ditinjau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI trasforma il materiale lungo in una trascrizione più riassunti concisi, quindi le idee principali sono facili da rivedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI は、長い資料をトランスクリプトと簡潔な要約に変換するため、主要なアイデアを簡単に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI은 긴 자료를 대본과 간결한 요약으로 변환하므로 주요 아이디어를 쉽게 검토할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI menukar bahan panjang menjadi transkrip serta ringkasan ringkas, jadi idea utama mudah untuk disemak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI gjør langt materiale til en utskrift pluss konsise oppsummeringer, slik at hovedideene er enkle å se gjennom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI zet lang materiaal om in een transcriptie plus beknopte samenvattingen, zodat de belangrijkste ideeën gemakkelijk te beoordelen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI zamienia długi materiał w transkrypcję i zwięzłe streszczenia, dzięki czemu łatwo jest przejrzeć główne myśli."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI transforma material longo em uma transcrição, além de resumos concisos, para que as ideias principais sejam fáceis de revisar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI transformă materialul lung într-o transcriere plus rezumate concise, astfel încât ideile principale sunt ușor de revizuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI превращает длинный материал в стенограмму и краткое изложение, поэтому основные идеи легко просмотреть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI premení dlhý materiál na prepis a stručné zhrnutia, takže hlavné myšlienky sa dajú ľahko skontrolovať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI förvandlar långt material till en utskrift plus kortfattade sammanfattningar, så att huvudidéerna är lätta att granska."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI เปลี่ยนเนื้อหายาวๆ ให้เป็นบทถอดเสียงพร้อมทั้งบทสรุปที่กระชับ ดังนั้นแนวคิดหลักจึงง่ายต่อการทบทวน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI uzun materyali bir transkript ve kısa özetlere dönüştürür, böylece ana fikirlerin gözden geçirilmesi kolaydır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI перетворює довгий матеріал на стенограму та стислі підсумки, тому основні ідеї легко переглядати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI chuyển tài liệu dài thành bản chép lại cùng với những bản tóm tắt ngắn gọn để dễ dàng xem lại các ý chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI 将长篇材料转化为文字记录和简明摘要，因此主要思想易于回顾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LectraAI 將長篇資料轉化為文字記錄和簡明摘要，因此主要想法易於回顧。"
          }
        }
      }
    },
