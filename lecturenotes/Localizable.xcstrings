        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγραφή \"%@\"; Οι εγγραφές θα παραμείνουν διαθέσιμες και απλώς θα αφαιρεθούν από αυτόν τον φάκελο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar \"%@\"? Las grabaciones seguirán estando disponibles y simplemente se eliminarán de esta carpeta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko \"%@\"? Tallenteet pysyvät saatavilla ja ne poistetaan vain tästä kansiosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer « %@ » ? Les enregistrements resteront disponibles et seront simplement supprimés de ce dossier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למחוק את \"%@\"? ההקלטות יישארו זמינות ורק יוסרו מהתיקייה הזו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" हटाएं? रिकॉर्डिंग उपलब्ध रहेंगी और बस इस फ़ोल्डर से हटा दी जाएंगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrisati \"%@\"? Snimke će ostati dostupne i samo će se ukloniti iz ove mape."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törli a következőt: \"%@\"? A felvételek továbbra is elérhetők maradnak, és csak eltávolítják őket ebből a mappából."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus \"%@\"? Rekaman akan tetap tersedia dan akan dihapus dari folder ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare \"%@\"? Le registrazioni rimarranno disponibili e verranno semplicemente rimosse da questa cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除しますか?録音は引き続き利用可能で、このフォルダーから削除されるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'을 삭제하시겠습니까? 녹음 파일은 계속 사용할 수 있으며 이 폴더에서 제거됩니다."
