        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padamkan \"%@\"? Rakaman akan kekal tersedia dan hanya akan dialih keluar daripada folder ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slette \"%@\"? Opptak vil forbli tilgjengelige og vil bare bli fjernet fra denne mappen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" verwijderen? Opnames blijven beschikbaar en worden gewoon uit deze map verwijderd."
