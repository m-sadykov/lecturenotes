    "By tapping Continue, you agree to share this content with these services so your lecture can be processed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند النقر على \"متابعة\"، فإنك توافق على مشاركة هذا المحتوى مع هذه الخدمات حتى يمكن معالجة محاضرتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tocar Continuar, acceptes compartir aquest contingut amb aquests serveis perquè la teva conferència es pugui processar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na Pokračovat souhlasíte se sdílením tohoto obsahu s těmito službami, aby mohla být vaše přednáška zpracována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved at trykke på Fortsæt accepterer du at dele dette indhold med disse tjenester, så dit foredrag kan behandles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indem Sie auf „Weiter“ tippen, erklären Sie sich damit einverstanden, diesen Inhalt mit diesen Diensten zu teilen, damit Ihr Vortrag bearbeitet werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατώντας Συνέχεια, συμφωνείτε να κοινοποιήσετε αυτό το περιεχόμενο με αυτές τις υπηρεσίες, ώστε η διάλεξή σας να μπορεί να υποβληθεί σε επεξεργασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar Continuar, aceptas compartir este contenido con estos servicios para que se pueda procesar tu conferencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauttamalla Jatka suostut jakamaan tämän sisällön näiden palvelujen kanssa, jotta luento voidaan käsitellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En appuyant sur Continuer, vous acceptez de partager ce contenu avec ces services afin que votre cours puisse être traité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "על ידי הקשה על המשך, אתה מסכים לשתף תוכן זה עם שירותים אלה כדי שניתן יהיה לעבד את ההרצאה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी रखें पर टैप करके, आप इस सामग्री को इन सेवाओं के साथ साझा करने के लिए सहमत होते हैं ताकि आपके व्याख्यान पर कार्रवाई की जा सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirom na Nastavi pristajete na dijeljenje ovog sadržaja s ovim uslugama kako bi se vaše predavanje moglo obraditi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Folytatás elemre koppintva beleegyezik, hogy megosztja ezt a tartalmat ezekkel a szolgáltatásokkal, hogy előadása feldolgozható legyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan mengetuk Lanjutkan, Anda setuju untuk membagikan konten ini ke layanan ini sehingga kuliah Anda dapat diproses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccando Continua, accetti di condividere questo contenuto con questi servizi in modo che la tua lezione possa essere elaborata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[続行] をタップすると、講義を処理できるように、このコンテンツをこれらのサービスと共有することに同意したことになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속을 탭하면 강의가 처리될 수 있도록 이 콘텐츠를 이러한 서비스와 공유하는 데 동의하게 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan mengetik Teruskan, anda bersetuju untuk berkongsi kandungan ini dengan perkhidmatan ini supaya kuliah anda boleh diproses."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved å trykke på Fortsett godtar du å dele dette innholdet med disse tjenestene slik at foredraget ditt kan behandles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door op Doorgaan te tikken, gaat u ermee akkoord deze inhoud met deze diensten te delen, zodat uw lezing kan worden verwerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikając Kontynuuj, zgadzasz się na udostępnienie tej zawartości tym usługom, aby umożliwić przetworzenie Twojego wykładu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar em Continuar, você concorda em compartilhar esse conteúdo com esses serviços para que sua palestra possa ser processada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingând Continuați, sunteți de acord să partajați acest conținut acestor servicii, astfel încât prelegerea dvs. să poată fi procesată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажимая «Продолжить», вы соглашаетесь поделиться этим контентом с этими службами, чтобы ваша лекция могла быть обработана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na Pokračovať súhlasíte so zdieľaním tohto obsahu s týmito službami, aby mohla byť vaša prednáška spracovaná."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att trycka på Fortsätt godkänner du att dela detta innehåll med dessa tjänster så att din föreläsning kan bearbetas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแตะดำเนินการต่อ แสดงว่าคุณตกลงที่จะแชร์เนื้อหานี้กับบริการเหล่านี้เพื่อให้สามารถดำเนินการบรรยายของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam'a dokunduğunuzda, dersinizin işlenebilmesi için bu içeriği bu hizmetlerle paylaşmayı kabul etmiş olursunuz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натискаючи «Продовжити», ви погоджуєтеся надати цей вміст цим службам, щоб ваша лекція могла бути оброблена."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bằng cách nhấn vào Tiếp tục, bạn đồng ý chia sẻ nội dung này với các dịch vụ này để bài giảng của bạn có thể được xử lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击“继续”即表示您同意与这些服务共享此内容，以便可以处理您的讲座。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊「繼續」即表示您同意與這些服務分享此內容，以便可以處理您的講座。"
          }
        }
      }
    },
