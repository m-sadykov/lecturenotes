        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć „%@”? Nagrania pozostaną dostępne i zostaną po prostu usunięte z tego folderu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir \"%@\"? As gravações permanecerão disponíveis e serão apenas removidas desta pasta."
