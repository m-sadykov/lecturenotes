        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ștergeți „%@”? Înregistrările vor rămâne disponibile și vor fi doar eliminate din acest dosar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить «%@»? Записи останутся доступными и будут просто удалены из этой папки."
