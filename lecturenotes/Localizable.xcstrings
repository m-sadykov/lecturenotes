    "To create transcripts, summaries, flashcards, and quizzes, the app sends your imported text, PDF, or audio recording to Firebase and OpenAI for processing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإنشاء النصوص المفرغة والملخصات والبطاقات التعليمية والاختبارات، يرسل التطبيق النص أو ملف PDF أو التسجيل الصوتي الذي تستورده إلى Firebase وOpenAI للمعالجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per crear transcripcions, resums, targetes flash i proves, l'aplicació envia el text importat, PDF o la gravació d'àudio a Firebase i OpenAI perquè es processin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li vytvořit přepisy, shrnutí, kartičky a kvízy, aplikace odešle váš importovaný text, PDF, nebo zvukový záznam do Firebase a OpenAI ke zpracování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at oprette transskriptioner, oversigter, flashcards og quizzer sender appen din importerede tekst, PDF eller lydoptagelse til Firebase og OpenAI til behandling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Transkripte, Zusammenfassungen, Karteikarten und Tests zu erstellen, sendet die App Ihren importierten Text, PDF, oder Ihre Audioaufzeichnung zur Verarbeitung an Firebase und OpenAI."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να δημιουργήσετε μεταγραφές, περιλήψεις, flashcards και κουίζ, η εφαρμογή στέλνει το εισαγόμενο κείμενο, PDF ή ηχογράφηση στα Firebase και OpenAI για επεξεργασία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para crear transcripciones, resúmenes, tarjetas didácticas y cuestionarios, la aplicación envía su texto importado, PDF, o grabación de audio a Firebase y OpenAI para su procesamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luodaksesi transkriptioita, yhteenvetoja, muistikortteja ja tietokilpailuja, sovellus lähettää tuodun tekstin, PDF tai äänitallenteen Firebase ja OpenAI käsittelyä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour créer des transcriptions, des résumés, des flashcards et des quiz, l'application envoie votre texte importé, PDF, ou votre enregistrement audio à Firebase et OpenAI pour traitement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי ליצור תמלילים, סיכומים, כרטיסי פלאש וחידונים, האפליקציה שולחת את הטקסט המיובא שלך, PDF, או הקלטת אודיו אל Firebase וOpenAI לעיבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रांसक्रिप्ट, सारांश, फ्लैशकार्ड और क्विज़ बनाने के लिए, ऐप आपके आयातित टेक्स्ट, PDF, या ऑडियो रिकॉर्डिंग को प्रोसेसिंग के लिए Firebase और OpenAI पर भेजता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za izradu prijepisa, sažetaka, kartica i kvizova, aplikacija šalje vaš uvezeni tekst, PDF ili audio snimku na Firebase i OpenAI na obradu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Átiratok, összefoglalók, kártyák és kvízek készítéséhez az alkalmazás elküldi az importált szöveget (PDF) vagy hangfelvételt a Firebase és OpenAI címre feldolgozás céljából."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membuat transkrip, ringkasan, kartu flash, dan kuis, aplikasi mengirimkan teks yang diimpor, PDF, atau rekaman audio ke Firebase dan OpenAI untuk diproses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per creare trascrizioni, riepiloghi, flashcard e quiz, l'app invia il testo importato, PDF o la registrazione audio a Firebase e OpenAI per l'elaborazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランスクリプト、要約、フラッシュカード、クイズを作成するために、アプリはインポートされたテキスト、PDF、または音声録音を Firebase および OpenAI に送信して処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트, 요약, 플래시카드 및 퀴즈를 만들기 위해 앱은 가져온 텍스트, PDF 또는 오디오 녹음을 처리를 위해 Firebase 및 OpenAI로 보냅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membuat transkrip, ringkasan, kad imbas dan kuiz, apl menghantar teks import anda, PDF atau rakaman audio ke Firebase dan OpenAI untuk diproses."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å lage transkripsjoner, sammendrag, flashcards og spørrekonkurranser sender appen din importerte tekst, PDF eller lydopptak til Firebase og OpenAI for behandling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om transcripties, samenvattingen, flashcards en quizzen te maken, stuurt de app uw geïmporteerde tekst, PDF of audio-opname naar Firebase en OpenAI voor verwerking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby utworzyć transkrypcje, streszczenia, fiszki i quizy, aplikacja wysyła zaimportowany tekst, PDF lub nagranie audio do Firebase i OpenAI w celu przetworzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para criar transcrições, resumos, flashcards e questionários, o aplicativo envia seu texto importado, PDF, ou gravação de áudio para Firebase e OpenAI para processamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a crea transcrieri, rezumate, carduri flash și chestionare, aplicația trimite textul dvs. importat, PDF sau înregistrarea audio către Firebase și OpenAI pentru procesare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для создания транскриптов, резюме, карточек и тестов приложение отправляет импортированный текст PDF или аудиозапись в Firebase и OpenAI для обработки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete vytvoriť prepisy, súhrny, kartičky a kvízy, aplikácia odošle váš importovaný text, PDF, alebo zvukový záznam do Firebase a OpenAI na spracovanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att skapa avskrifter, sammanfattningar, flashcards och frågesporter skickar appen din importerade text, PDF eller ljudinspelning till Firebase och OpenAI för bearbetning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการสร้างการถอดเสียง สรุป บัตรคำศัพท์ และแบบทดสอบ แอปจะส่งข้อความที่นำเข้า PDF หรือการบันทึกเสียงไปยัง Firebase และ OpenAI เพื่อประมวลผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, transkriptler, özetler, bilgi kartları ve testler oluşturmak için içe aktarılan metninizi, PDF veya ses kaydınızı işlenmek üzere Firebase ve OpenAI'ye gönderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб створити стенограми, підсумки, картки та тести, програма надсилає ваш імпортований текст, PDF або аудіозапис до Firebase та OpenAI для обробки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tạo bản ghi, tóm tắt, thẻ nhớ và câu hỏi, ứng dụng sẽ gửi văn bản đã nhập của bạn, PDF hoặc bản ghi âm đến Firebase và OpenAI để xử lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要创建成绩单、摘要、抽认卡和测验，应用程序会将导入的文本、PDF 或录音发送到 Firebase 和 OpenAI 进行处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
