    "Move from passive reading to active recall with built-in study modes generated from each lecture." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل من القراءة السلبية إلى الاسترجاع النشط عبر أوضاع دراسة مدمجة تُنشأ من كل محاضرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passeu de la lectura passiva a la memòria activa amb els modes d'estudi integrats generats a cada conferència."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejděte od pasivního čtení k aktivnímu vyvolávání pomocí vestavěných studijních režimů generovaných z každé přednášky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt fra passiv læsning til aktiv genkaldelse med indbyggede studietilstande genereret fra hver forelæsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechseln Sie vom passiven Lesen zum aktiven Erinnern mit integrierten Lernmodi, die aus jeder Vorlesung generiert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταβείτε από την παθητική ανάγνωση στην ενεργητική ανάκληση με ενσωματωμένους τρόπους μελέτης που δημιουργούνται από κάθε διάλεξη."
          }
        },
        "es" : {
